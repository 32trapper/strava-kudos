import os
import re
import json
import time
from pathlib import Path

from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC


class StravaFeedWatcher:
    def __init__(self, controller):
        self.controller = controller
        self.driver = controller.driver

        self.poll_interval = int(
            os.getenv("STRAVA_POLL_INTERVAL", "300")
        )

        self.auto_comment = (
            os.getenv(
                "STRAVA_AUTO_COMMENT",
                "false",
            ).lower()
            == "true"
        )

        self.my_athlete_id = os.getenv(
            "STRAVA_ATHLETE_ID",
            "128175714",
        )

        self.state_file = Path(
            os.getenv(
                "STRAVA_STATE_FILE",
                "strava_processed.json",
            )
        )

        self.processed = self._load_state()

    # ---------------------------------------------------------
    # State
    # ---------------------------------------------------------

    def _load_state(self):
        if not self.state_file.exists():
            return set()

        try:
            with self.state_file.open(
                "r",
                encoding="utf-8",
            ) as file:
                data = json.load(file)

            return set(str(x) for x in data)

        except Exception as error:
            print(
                f"Could not load state file: {error}"
            )
            return set()

    def _save_state(self):
        try:
            with self.state_file.open(
                "w",
                encoding="utf-8",
            ) as file:
                json.dump(
                    sorted(self.processed),
                    file,
                    indent=2,
                )

        except Exception as error:
            print(
                f"Could not save state file: {error}"
            )

    # ---------------------------------------------------------
    # Feed
    # ---------------------------------------------------------

    def open_following_feed(self):
        print("Opening Strava Following feed...")

        self.driver.get(
            "https://www.strava.com/dashboard"
            "?feed_type=following"
        )

        WebDriverWait(
            self.driver,
            20,
        ).until(
            EC.presence_of_element_located(
                (By.TAG_NAME, "body")
            )
        )

        time.sleep(3)

    def find_activity_ids(self):
        """
        Find activity links currently loaded in the feed.
        """

        links = self.driver.find_elements(
            By.CSS_SELECTOR,
            "a[href*='/activities/']",
        )

        activity_ids = []

        for link in links:
            try:
                href = link.get_attribute("href")

                if not href:
                    continue

                match = re.search(
                    r"/activities/(\d+)",
                    href,
                )

                if not match:
                    continue

                activity_id = match.group(1)

                if activity_id not in activity_ids:
                    activity_ids.append(
                        activity_id
                    )

            except Exception:
                continue

        return activity_ids

    # ---------------------------------------------------------
    # Processing
    # ---------------------------------------------------------

    def process_activity(self, activity_id):
        activity_id = str(activity_id)

        if activity_id in self.processed:
            return

        print(
            f"Checking activity {activity_id}..."
        )

        if self.is_my_activity(activity_id):
            print(
                f"Activity {activity_id} is yours. "
                "Skipping."
            )

            self.processed.add(activity_id)
            self._save_state()
            return

        print(
            f"Activity {activity_id} belongs to "
            "someone you follow."
        )

        try:
            result = self.controller.give_kudos(
                int(activity_id)
            )

            if result is False:
                print(
                    f"Could not give kudos to "
                    f"{activity_id}."
                )
                return

            print(
                f"Kudos given to activity "
                f"{activity_id}."
            )

            if self.auto_comment:
                from comments import fetch_random_comment

                comment = fetch_random_comment()

                if comment:
                    self.controller.post_comment(
                        int(activity_id),
                        comment,
                    )

            self.processed.add(activity_id)
            self._save_state()

        except Exception as error:
            print(
                f"Error processing activity "
                f"{activity_id}: {error}"
            )

    # ---------------------------------------------------------
    # Determine activity owner
    # ---------------------------------------------------------

    def is_my_activity(self, activity_id):
        """
        Open the activity and inspect the athlete profile
        link to determine who owns it.
        """

        self.driver.get(
            f"https://www.strava.com/activities/"
            f"{activity_id}"
        )

        WebDriverWait(
            self.driver,
            15,
        ).until(
            EC.presence_of_element_located(
                (By.TAG_NAME, "body")
            )
        )

        time.sleep(1)

        athlete_links = self.driver.find_elements(
            By.CSS_SELECTOR,
            "a[href*='/athletes/']",
        )

        for link in athlete_links:
            try:
                href = link.get_attribute("href")

                if not href:
                    continue

                match = re.search(
                    r"/athletes/(\d+)",
                    href,
                )

                if match:
                    athlete_id = match.group(1)

                    return (
                        athlete_id
                        == self.my_athlete_id
                    )

            except Exception:
                continue

        print(
            f"WARNING: Could not determine owner "
            f"of activity {activity_id}."
        )

        # Safety first: if we can't determine who owns
        # the activity, don't interact with it.
        return True

    # ---------------------------------------------------------
    # One polling pass
    # ---------------------------------------------------------

    def check_once(self):
        print("")
        print("=" * 60)
        print(
            "Checking Strava feed..."
        )
        print("=" * 60)

        self.open_following_feed()

        activity_ids = self.find_activity_ids()

        print(
            f"Found {len(activity_ids)} "
            "activities in feed."
        )

        for activity_id in activity_ids:
            self.process_activity(
                activity_id
            )

    # ---------------------------------------------------------
    # Main loop
    # ---------------------------------------------------------

    def run(self):
        print(
            "Starting Strava feed watcher."
        )

        print(
            f"Polling every "
            f"{self.poll_interval} seconds."
        )

        print(
            f"Automatic comments: "
            f"{self.auto_comment}"
        )

        while True:
            try:
                self.check_once()

            except KeyboardInterrupt:
                print(
                    "Stopping Strava feed watcher."
                )
                break

            except Exception as error:
                print(
                    f"Feed watcher error: {error}"
                )

            print(
                f"Sleeping for "
                f"{self.poll_interval} seconds..."
            )

            time.sleep(
                self.poll_interval
            )